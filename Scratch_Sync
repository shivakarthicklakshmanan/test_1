from navigator import list_dashboard_tabs, _detect_chrome_labels

print("URL before anything:", b.url())

raw_tabs = list_dashboard_tabs(b)
print(f"\n{len(raw_tabs)} raw link(s) found (Contact Us already excluded):")
for t in raw_tabs:
    print(f"  text={t['text']!r:40s} href={t.get('href')!r}")

print("\n--- running _detect_chrome_labels ---")
chrome = _detect_chrome_labels(b, raw_tabs)
print("chrome_labels detected:", chrome)

print("\nURL after chrome detection:", b.url())



from navigator import list_dashboard_tabs, scrape_dashboard, _normalize_label_for_match

manual_chrome = {_normalize_label_for_match(x) for x in [
    "Home", "About Us", "Access Management", "Hits", "Journal", "EWS New",
    "Search", "What's New", "Quick Links", "Feedback", "Contact Us",
    "Channel Migration and Adoption", "GenAI Chatbots",
]}

tabs = list_dashboard_tabs(b, chrome_labels=manual_chrome)
print(f"{len(tabs)} real tile(s) after manual exclusion:")
for t in tabs:
    print(" -", t['text'])

if tabs:
    first_label = tabs[0]['text']
    results = scrape_dashboard(b, first_label, chrome_labels=manual_chrome)
    print(f"\nResults from '{first_label}':")
    for r in results:
        print(" -", r.label, "|", r.url)
