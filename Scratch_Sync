import code
import config
#from navigator import open_browser, enter_portal, diagnose_contact_us_link
from navigator import open_browser, enter_portal, diagnose_contact_us_link, describe_dropdowns, scrape_dashboard, list_dashboard_tabs


def main():
    print("Opening browser (headed) and clicking Confirm...")
    with open_browser(headed=True) as b:
        enter_portal(b)
        print(f"\nLanded on: {b.url()}")
        print("You're now at an interactive prompt with `b` bound to the "
              "live browser. Try b.get_text(), b.links(), b.find('contact'), "
              "b.screenshot('look.png'), b.click('...'), b.back(), etc.\n"
              "Ctrl-D / exit() to close the browser and quit.\n")

        local_vars = {
            "b": b,
            "config": config,
            "diagnose_contact_us_link": lambda label=None: diagnose_contact_us_link(b, label),
        }
        code.interact(banner="", local=local_vars)


if __name__ == "__main__":
    main()
